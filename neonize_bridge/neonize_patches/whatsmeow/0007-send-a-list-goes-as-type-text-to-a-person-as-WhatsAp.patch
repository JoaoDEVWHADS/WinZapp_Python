From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Tue, 27 Oct 2026 08:35:51 -0300
Subject: [PATCH 07/15] send: a list goes as type text to a person, as WhatsApp
 Web sends it

WhatsApp Web's stanza for a list to a person (captured over CDP on
2026-10-27): <message type="text">, <enc mediatype="list">, <biz><list
v="2" type="product_list"/></biz>. To a group it stays type "media"
(wa-js applyGroupListStanza).
---
 send.go                 | 13 ++++++++++++-
 send_nativeflow_test.go | 18 ++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/send.go b/send.go
index eaafaf7..4a29ded 100644
--- a/send.go
+++ b/send.go
@@ -956,6 +956,17 @@ func getTypeFromMessage(msg *waE2E.Message) string {
 	}
 }
 
+// chatMessageType is the <message> type for `to`. A list goes as "text" to a
+// person, as WhatsApp Web sends it (wa-js forces typeAttributeFromProtobuf to
+// "text" for a list), and as "media" with mediatype "list" to a group (wa-js
+// applyGroupListStanza), which is getTypeFromMessage's answer.
+func chatMessageType(msg *waE2E.Message, to types.JID) string {
+	if to.Server != types.GroupServer && getButtonTypeFromMessage(msg) == "list" {
+		return "text"
+	}
+	return getTypeFromMessage(msg)
+}
+
 func getMediaTypeFromMessage(msg *waE2E.Message) string {
 	switch {
 	case msg.ViewOnceMessage != nil:
@@ -1296,7 +1307,7 @@ func (cli *Client) prepareMessageNode(
 		})
 	}
 
-	msgType := getTypeFromMessage(message)
+	msgType := chatMessageType(message, to)
 	encAttrs := waBinary.Attrs{}
 	// Only include encMediaType for 1:1 messages (groups don't have a device-sent message plaintext)
 	if encMediaType := getMediaTypeFromMessage(message); dsmPlaintext != nil && encMediaType != "" {
diff --git a/send_nativeflow_test.go b/send_nativeflow_test.go
index f3cf754..665f761 100644
--- a/send_nativeflow_test.go
+++ b/send_nativeflow_test.go
@@ -7,6 +7,7 @@ import (
 
 	waBinary "go.mau.fi/whatsmeow/binary"
 	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
 )
 
 func nativeFlow(button string) *waE2E.Message {
@@ -85,3 +86,20 @@ func TestANativeFlowReplyNamesItsFlow(t *testing.T) {
 		t.Errorf("%q", name)
 	}
 }
+
+func TestAListIsTextToAPersonAndMediaToAGroup(t *testing.T) {
+	list := &waE2E.Message{ListMessage: &waE2E.ListMessage{}}
+	if got := chatMessageType(list, types.NewJID("5511", types.DefaultUserServer)); got != "text" {
+		t.Errorf("to a person: %s", got)
+	}
+	if got := chatMessageType(list, types.NewJID("1", types.HiddenUserServer)); got != "text" {
+		t.Errorf("to a lid: %s", got)
+	}
+	if got := chatMessageType(list, types.NewJID("1203", types.GroupServer)); got != "media" {
+		t.Errorf("to a group: %s", got)
+	}
+	text := &waE2E.Message{Conversation: proto.String("hi")}
+	if got := chatMessageType(text, types.NewJID("5511", types.DefaultUserServer)); got != "text" {
+		t.Errorf("a text: %s", got)
+	}
+}
